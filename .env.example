# Copy to .env and edit.  `docker compose` reads this file; for `npm run dev` the server loads it via dotenv.

# ---- Required -------------------------------------------------------------------------
# Local (npm run dev) connection string. Docker Compose builds its own from POSTGRES_PASSWORD.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sayphora_db
# >= 32 random characters:  openssl rand -base64 48
JWT_SECRET=generate-a-long-random-secret-here-at-least-32-chars
# Docker Compose only. Use hex (openssl rand -hex 24) so the value is URL-safe.
POSTGRES_PASSWORD=change-me-hex-only

# ---- Server ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public URL of the site (used for CSRF origin checks and links in emails).
APP_URL=http://localhost:3000
# Run pending SQL migrations automatically on boot (safe with multiple replicas).
RUN_MIGRATIONS_ON_START=true
DATABASE_POOL_MAX=10
DATABASE_SSL=false
# Secure cookies. Defaults to true in production; set false only for plain-http testing.
# COOKIE_SECURE=false
# Number of reverse proxies in front of the app (1 for nginx/Caddy/Traefik/most PaaS) so rate limiting sees real client IPs.
TRUST_PROXY=0
SESSION_TTL_DAYS=7
# scrypt cost (log2 N). 15 is a good production default.
PASSWORD_HASH_COST=15
LOG_LEVEL=info
# Never enable in production.
RATE_LIMIT_DISABLED=false

# ---- Commerce -------------------------------------------------------------------------
# Flat sales tax rate applied to every order (0.08875 = 8.875%). See README "Known limitations".
TAX_RATE=0.08875

# ---- Admin bootstrap (used by `npm run db:seed`; an existing admin is never overwritten) --
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Development only: seeds a demo customer, promo codes (SAYPHORA20, ...) and sample reviews.
SEED_DEMO=false

# ---- Optional integrations ------------------------------------------------------------
# Gemini powers AI copy and Maps grounding. Without a key the built-in rule-based assistant is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# SMTP for order / password-reset emails. Without it, emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Sayphora <no-reply@example.com>
